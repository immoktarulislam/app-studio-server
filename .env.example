# Server port for the StudioSpace API
PORT=5000

# MongoDB connection string (the database name in the path defaults to "studiospace")
MONGODB_URI=mongodb://localhost:27017/studiospace

# Secret used to sign JWT session cookies — replace with a long random string
JWT_SECRET=change-me-to-a-long-random-secret

# Allowed browser origin for credentialed CORS requests
CLIENT_URL=http://localhost:3000

# Google OAuth client id used to verify Google ID tokens (optional)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
